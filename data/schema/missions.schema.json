{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "missions"],
  "properties": {
    "schema_version": {"const": 1},
    "compiled_on": {"type": "string"},
    "missions": {
      "type": "array",
      "items": {"$ref": "#/$defs/mission"}
    },
    "reference_sites": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference_site"}
    },
    "candidate_sites": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate_site"}
    }
  },
  "$defs": {
    "date": {
      "type": "object",
      "required": ["date", "precision", "kind"],
      "properties": {
        "date": {"type": ["string", "null"]},
        "precision": {"enum": ["day", "month", "quarter", "year", null]},
        "kind": {"enum": ["actual", "planned", null]}
      }
    },
    "mission": {
      "type": "object",
      "required": ["id", "name", "provider", "status", "dates", "site", "sources", "verified"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string"},
        "program_label": {"type": ["string", "null"]},
        "clps_task_order": {"type": ["string", "null"]},
        "provider": {"type": "string"},
        "lander": {"type": "string"},
        "status": {
          "enum": ["planned", "launched", "landed_success", "landed_partial", "failed", "cancelled", "unknown_needs_check"]
        },
        "dates": {
          "type": "object",
          "required": ["launch", "landing"],
          "properties": {
            "launch": {"$ref": "#/$defs/date"},
            "landing": {"$ref": "#/$defs/date"}
          }
        },
        "site": {
          "type": "object",
          "required": ["name", "lat", "lon", "coord_kind", "terrain_tier"],
          "properties": {
            "name": {"type": "string"},
            "region_type": {"type": "string"},
            "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
            "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
            "coord_kind": {"enum": ["actual", "planned", "planned_region_center", "unknown"]},
            "elevation_m": {"type": ["number", "null"]},
            "uncertainty_km": {"type": ["number", "null"]},
            "terrain_tier": {"enum": ["T1", "T2", "T3"]}
          }
        },
        "payload_highlights": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "title", "accessed", "supports"],
            "properties": {
              "url": {"type": "string"},
              "title": {"type": "string"},
              "accessed": {"type": "string"},
              "supports": {"type": "string"}
            }
          }
        },
        "verified": {"type": "boolean"}
      }
    },
    "reference_site": {
      "type": "object",
      "required": ["id", "name", "lat", "lon"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string"},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "source": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "candidate_site": {
      "type": "object",
      "required": ["id", "name", "lat_center", "lon_center", "verified"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "record_type": {"type": "string"},
        "name": {"type": "string"},
        "lat_center": {"type": "number", "minimum": -90, "maximum": 90},
        "lon_center": {"type": "number", "minimum": -180, "maximum": 180},
        "coord_type": {"type": "string"},
        "coordinate_kind": {"type": "string"},
        "region_size_km": {"type": "number"},
        "uncertainty_km": {"type": ["number", "null"]},
        "source_url": {"type": "string"},
        "source_alt": {"type": "string"},
        "source_date": {"type": "string"},
        "notes": {"type": "string"},
        "verified": {"type": "boolean"}
      }
    }
  }
}
