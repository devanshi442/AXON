{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "missions"],
  "properties": {
    "schema_version": {"const": 1},
    "missions": {"type": "array", "items": {"$ref": "#/$defs/mission"}},
    "reference_sites": {"type": "array"}
  },
  "$defs": {
    "date": {"type": "object", "required": ["date", "precision", "kind"],
      "properties": {"date": {"type": ["string", "null"]},
        "precision": {"enum": ["day", "month", "quarter", "year", null]},
        "kind": {"enum": ["actual", "planned", null]}}},
    "mission": {"type": "object",
      "required": ["id", "name", "provider", "status", "dates", "site", "sources", "verified"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "status": {"enum": ["planned", "launched", "landed_success", "landed_partial", "failed", "cancelled", "unknown_needs_check"]},
        "dates": {"type": "object", "required": ["launch", "landing"],
          "properties": {"launch": {"$ref": "#/$defs/date"}, "landing": {"$ref": "#/$defs/date"}}},
        "site": {"type": "object", "required": ["name", "lat", "lon", "coord_kind", "terrain_tier"],
          "properties": {
            "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
            "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
            "coord_kind": {"enum": ["actual", "planned", "planned_region_center", "unknown"]},
            "terrain_tier": {"enum": ["T1", "T2", "T3"]}}},
        "sources": {"type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["url", "title", "accessed", "supports"]}},
        "verified": {"type": "boolean"}}}
  }
}
